# Supabase (from your Supabase project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this to the client / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Payment provider (PayMongo or Xendit) — used only by server-side API routes.
PAYMENT_PROVIDER=paymongo
PAYMENT_PROVIDER_SECRET=
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# Base URL of the deployed app, used to build QR code links and webhook callback URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
